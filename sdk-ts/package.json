{
  "name": "@agents-arena/sdk",
  "version": "0.2.0",
  "description": "TypeScript client for the AgentsArena WebSocket protocol (wire schema_version 4).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "~5.8.0"
  }
}
