"""Ollama prompt builder for ${Name}: the rules, the seat's view, a JSON choice."""

from __future__ import annotations

import json
from typing import Any

from arena.agents.ollama._adapters import OllamaGameAdapter, register_ollama_adapter
from arena.games.${name}.actions import CHOICES, ${Name}Action
from arena.games.${name}.definition import (
    ${NAME}_GAME_ID,
    ${Name}GameDefinition,
)
from arena.games.${name}.rules import RULES_SUMMARY


class ${Name}PromptBuilder:
    """Build Ollama chat messages and parse responses for ${Name}."""

    SYSTEM_PROMPT = RULES_SUMMARY + "\n\nRespond with a JSON object naming your choice."

    def build_messages(
        self,
        observation: Any,
        retry_feedback: tuple[str, ...] = (),
    ) -> list[dict[str, str]]:
        # The observation is exactly what this seat may see, so describing it
        # cannot leak anything. A hand-written description reads better.
        view = ${Name}GameDefinition.serializer.dump_observation(observation)
        legal = [action.choice for action in observation.legal_actions]
        user_lines = [
            f"You are seat {observation.seat}. What you can see:",
            json.dumps(view, sort_keys=True),
            f"Legal choices: {json.dumps(legal)}",
            'Respond with JSON: {"thought": "<one sentence>", '
            '"choice": "<one of the legal choices>"}',
        ]
        if retry_feedback:
            feedback_items = "\n".join(f" - {item}" for item in retry_feedback)
            user_lines.append(f"Previous attempts were rejected:\n{feedback_items}")
        return [
            {"role": "system", "content": self.SYSTEM_PROMPT},
            {"role": "user", "content": "\n".join(user_lines)},
        ]

    def parse_response(self, content: str, observation: Any) -> Any | None:
        try:
            data = json.loads(content)
        except (json.JSONDecodeError, ValueError):
            return None
        if not isinstance(data, dict):
            return None
        choice = data.get("choice")
        if not isinstance(choice, str):
            return None
        choice = choice.strip().lower()
        if choice not in CHOICES:
            return None
        action = ${Name}Action(choice=choice)
        return action if action in observation.legal_actions else None

    def format_spec(self) -> dict[str, Any]:
        return {
            "type": "object",
            "properties": {
                "thought": {"type": "string"},
                "choice": {"type": "string", "enum": list(CHOICES)},
            },
            "required": ["thought", "choice"],
        }

    def describe_invalid(self, raw_content: str) -> str:
        return (
            f"Response was not a legal choice (one of {', '.join(CHOICES)}). "
            f"Raw content: {raw_content[:200]}"
        )


register_ollama_adapter(
    OllamaGameAdapter(
        game_id=${NAME}_GAME_ID,
        prompt_builder_factory=${Name}PromptBuilder,
    )
)


__all__: tuple[str, ...] = ("${Name}PromptBuilder",)
